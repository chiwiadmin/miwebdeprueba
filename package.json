{
  "name": "juego-rock-nacional",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\"",
    "dev": "wrangler pages dev public --port 8788",
    "db:local:init": "wrangler d1 execute lulupacho-db --local --file=db/schema.sql",
    "seed:test": "node scripts/build-seed.mjs db/songs.example.json private/seed.sql --allow-test --start today && wrangler d1 execute lulupacho-db --local --file=private/seed.sql",
    "seed:build": "node scripts/build-seed.mjs private/songs-30-days.json private/seed.sql"
  },
  "devDependencies": {
    "wrangler": "^4.152.0"
  }
}